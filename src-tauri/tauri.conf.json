{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SF DevKit",
  "version": "0.7.5",
  "identifier": "com.sfdevkit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "title": "SF DevKit",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCNzIyQ0VEODNGQTZGMUUKUldRZWIvcUQ3U3h5MjY4T21pVis2NVVkek9rWEVYZlJ6NTRBcEwxeUpQbWdxcDhwalI0MDBkT3EK",
      "endpoints": [
        "https://github.com/windwoke/SF-DevKit/releases/latest/download/latest.json"
      ]
    }
  }
}
